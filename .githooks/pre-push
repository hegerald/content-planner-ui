#!/bin/sh
# Git-Hook vor jedem Push (gilt für Menschen und jeden KI-Agent gleichermaßen):
# Die Teile dieses Repos müssen grün sein – dieselbe Prüfung wie die CI
# (`scripts/verify.mjs ui-service frontend okf`). Das Backend hat seinen eigenen Hook.
# Einmalig aktivieren: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
node scripts/verify.mjs ui-service frontend okf --quiet || {
  echo "Push blockiert: node scripts/verify.mjs ist fehlgeschlagen. Erst reparieren, dann erneut pushen." >&2
  exit 1
}
