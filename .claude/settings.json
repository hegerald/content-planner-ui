{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": [
      "../content-planner-backend"
    ],
    "allow": [
      "Bash(mvn test)",
      "Bash(mvn test *)",
      "Bash(mvn package)",
      "Bash(mvn package *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run build)",
      "Bash(node scripts/verify.mjs)",
      "Bash(node scripts/verify.mjs *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(../content-planner-backend/.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-before-push.mjs\"",
            "timeout": 600,
            "statusMessage": "Prüfe UI-Service, Frontend und Wissens-Bundle vor git push …"
          }
        ]
      }
    ]
  }
}
